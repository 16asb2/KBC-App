rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    // Caller must be a signed-in Firebase user
    function isSignedIn() {
      return request.auth != null;
    }

    // Caller is the owner of this document (uid matches doc id)
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Read the caller's member profile to check a boolean flag
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSupervisor() {
      return isSignedIn() && callerProfile().isSupervisor == true;
    }

    function isAdmin() {
      return isSignedIn() && callerProfile().isAdmin == true;
    }

    function isPrivileged() {
      return isSupervisor() || isAdmin();
    }

    // Prevent a user from changing their own isAdmin or isSupervisor flags.
    // Only allowed when the incoming value matches the existing value.
    function privilegeFlagsUnchanged() {
      let incoming = request.resource.data;
      let existing = resource.data;
      return (!('isAdmin' in incoming) || incoming.isAdmin == existing.isAdmin)
          && (!('isSupervisor' in incoming) || incoming.isSupervisor == existing.isSupervisor);
    }

    // ─── Members ─────────────────────────────────────────────────────────────
    // Collection: users/{uid}
    // Supervisors and admins can read any member doc.
    // Regular users can only read their own doc.
    // A user may update their own doc but cannot change isAdmin / isSupervisor.
    // Only admins can change privilege flags.

    match /users/{uid} {
      allow read: if isPrivileged() || isOwner(uid);

      // Self-updates: allowed, but privilege flags must not change
      allow update: if isOwner(uid) && privilegeFlagsUnchanged();

      // Privileged updates: supervisors can update non-privilege fields; admins can change any field
      allow update: if isSupervisor() && privilegeFlagsUnchanged();
      allow update: if isAdmin();

      // Only admins can create or delete member docs
      allow create, delete: if isAdmin();
    }

    // ─── Logs ────────────────────────────────────────────────────────────────
    // Collection: logs/{id}
    // Any signed-in user can read; only supervisors/admins can write/delete.

    match /logs/{logId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isPrivileged();
    }

    // ─── Gym Status ──────────────────────────────────────────────────────────
    // Single document: gymStatus/current
    // Any signed-in user can read (used to show open/closed on home screen).
    // Only supervisors/admins can update it.

    match /gymStatus/current {
      allow read: if isSignedIn();
      allow write: if isPrivileged();
    }

    // ─── Boulders ────────────────────────────────────────────────────────────
    // Collection: boulders/{id}
    // Any signed-in member can read; only admins can create, update, or delete.
    // Voting fields (gradeVotes, qualityVotes, badges, ascentCount) are
    // community-writable by any signed-in user.

    match /boulders/{boulderId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();

      // Admin can update any field
      allow update: if isAdmin();

      // Signed-in users can write community vote fields only
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['gradeVotes', 'qualityVotes', 'badges', 'ascentCount', 'comments', 'updatedAt']);
    }

    // ─── Boulder Seasons ─────────────────────────────────────────────────────

    match /boulderSeasons/{seasonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Climb Logs ──────────────────────────────────────────────────────────
    // Collection: climbLogs/{id}
    // Users may only read/write their own entries (field uid must match auth uid).

    match /climbLogs/{logId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ─── Climb Locations ─────────────────────────────────────────────────────
    // Collection: climbLocations/{id}
    // Users may only read/write their own locations.

    match /climbLocations/{locationId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ─── Session Requests ────────────────────────────────────────────────────
    // Collection: sessionRequests/{id}
    // Any signed-in user can create a request for themselves.
    // Supervisors/admins can read and update all requests.

    match /sessionRequests/{requestId} {
      allow create: if isSignedIn()
                    && request.resource.data.requesterUid == request.auth.uid;
      allow read, update, delete: if isPrivileged();
      // Requester can read their own request
      allow read: if isSignedIn() && resource.data.requesterUid == request.auth.uid;
    }

    // ─── Default deny ────────────────────────────────────────────────────────
    // Any collection not explicitly listed above is denied.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
