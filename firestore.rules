rules_version = '2';

// MIGRATION IN PROGRESS: Firebase Auth token exchange is not yet verified working.
// Reads are temporarily open (same as before this PR).
// Re-enable strict per-collection rules once Firebase Auth is confirmed working
// (sign out → sign in → check that Firestore requests include Authorization header).

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
