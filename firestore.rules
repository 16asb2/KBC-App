rules_version = '2';

// ─── KBC App — Firestore Security Rules ──────────────────────────────────────
//
// Auth model:
//   - request.auth is the Firebase Auth user (Google Sign-In via authBridge.ts)
//   - Super-admin: hardcoded email below (mirrors EXPO_PUBLIC_SUPER_ADMIN_EMAIL)
//   - Admin:       users/{uid}.isAdmin == true  (set by other admins in-app)
//   - Supervisor:  users/{uid}.isSupervisor == true  (set by admins)
//   - Member:      any authenticated user

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      // Keep in sync with EXPO_PUBLIC_SUPER_ADMIN_EMAIL in your .env / EAS vars
      return isAuthenticated() &&
        request.auth.token.email == '16asb2@gmail.com';
    }

    function memberDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function memberDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSupervisorOrAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (memberDocExists() && (
          memberDoc().data.get('isAdmin', false) == true ||
          memberDoc().data.get('isSupervisor', false) == true
        ))
      );
    }

    // Fields that only admins/supervisors may change on a boulder document.
    // Regular members can update any other field (grade votes, quality votes,
    // badge votes, updatedAt, etc.) without restriction.
    function touchesBoulderAdminFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'name', 'setter', 'setterEmail', 'number', 'seasonId',
        'locations', 'photo', 'removed', 'internalId', 'local', 'area',
        'permissions', 'createdAt'
      ]);
    }

    // Fields that only admins/supervisors may change on a member document.
    // A member updating their own profile cannot escalate privileges.
    function touchesMemberPrivilegedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isAdmin', 'isSupervisor', 'membershipStatus', 'membershipStart',
        'membershipExpiry', 'punchPassRemaining', 'pendingMembership',
        'pendingPunches', 'amendedBy'
      ]);
    }

    // A member may update their own access/purchase state as long as they
    // don't touch role fields and don't self-approve to 'active'.
    function canSelfUpdateAccess(uid) {
      return isAuthenticated() &&
        request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isSupervisor', 'amendedBy']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['membershipStatus']) ||
          request.resource.data.membershipStatus == 'pending');
    }

    // ── users/{uid} ───────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isAuthenticated();
      // Supervisors/admins can create any profile; authenticated users can self-register
      // as long as they don't grant themselves admin or supervisor privileges.
      allow create: if isSupervisorOrAdmin() ||
                       (isAuthenticated() &&
                        request.auth.uid == uid &&
                        request.resource.data.get('isAdmin', false) == false &&
                        request.resource.data.get('isSupervisor', false) == false);
      allow delete: if isSupervisorOrAdmin();
      allow update: if isSupervisorOrAdmin() ||
                       (isAuthenticated() &&
                        request.auth.uid == uid &&
                        !touchesMemberPrivilegedFields()) ||
                       // Members may purchase/use access for themselves (pending admin confirmation).
                       // They can write access fields but cannot set membershipStatus to 'active'
                       // and cannot touch role fields.
                       canSelfUpdateAccess(uid) ||
                       // Auto-expire: members can self-downgrade to 'inactive' when their
                       // membership lapses — they cannot upgrade themselves.
                       (isAuthenticated() &&
                        request.auth.uid == uid &&
                        resource.data.membershipStatus in ['active', 'pending'] &&
                        request.resource.data.membershipStatus == 'inactive' &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['membershipStatus', 'lastUpdatedBy', 'lastUpdatedAt']));
    }

    // ── logs/{id} ─────────────────────────────────────────────────────────────
    // All members read the sign-in book; purchase entries are filtered client-side.
    match /logs/{logId} {
      allow read:           if isAuthenticated();
      allow create:         if isAuthenticated();
      allow update, delete: if isSupervisorOrAdmin();
    }

    // ── boulderSeasons/{id} ───────────────────────────────────────────────────
    match /boulderSeasons/{seasonId} {
      allow read:  if isAuthenticated();
      allow write: if isSupervisorOrAdmin();
    }

    // ── boulders/{id} ────────────────────────────────────────────────────────
    // Members can vote (grade, quality, badges); only admins/supervisors can
    // create, delete, or change structural fields.
    match /boulders/{boulderId} {
      allow read:           if isAuthenticated();
      allow create, delete: if isSupervisorOrAdmin();
      allow update:         if isSupervisorOrAdmin() ||
                               (isAuthenticated() && !touchesBoulderAdminFields());

      match /comments/{commentId} {
        allow read:           if isAuthenticated();
        allow create:         if isAuthenticated();
        allow update, delete: if isAuthenticated() &&
                                 (resource.data.uid == request.auth.uid ||
                                  isSupervisorOrAdmin());
      }
    }

    // ── climbLogs/{id} ───────────────────────────────────────────────────────
    // KBC logs (locationId == 'kbc') are readable by all members — used for
    // community stats on boulder cards. Logs at other locations are private.
    match /climbLogs/{logId} {
      allow read:           if isAuthenticated() && (
                               resource.data.uid == request.auth.uid ||
                               resource.data.locationId == 'kbc'
                            );
      allow create:         if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── climbLocations/{id} ──────────────────────────────────────────────────
    match /climbLocations/{locId} {
      allow read:           if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create:         if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── personalProblems/{id} ────────────────────────────────────────────────
    match /personalProblems/{problemId} {
      allow read:           if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create:         if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── gymStatus/{doc} ──────────────────────────────────────────────────────
    match /gymStatus/{doc} {
      allow read:  if isAuthenticated();
      allow write: if isSupervisorOrAdmin();
    }
  }
}
