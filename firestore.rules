rules_version = '2';

// ─── KBC App — Firestore Security Rules ──────────────────────────────────────
//
// Auth model:
//   - request.auth is the Firebase Auth user (Google Sign-In via authBridge.ts)
//   - Super-admin: hardcoded email below (mirrors EXPO_PUBLIC_SUPER_ADMIN_EMAIL)
//   - Admin:       users/{uid}.isAdmin == true  (set by other admins in-app)
//   - Supervisor:  users/{uid}.isSupervisor == true  (set by admins)
//   - Member:      any authenticated user

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      // Keep in sync with EXPO_PUBLIC_SUPER_ADMIN_EMAIL in your .env / EAS vars
      return isAuthenticated() &&
        request.auth.token.email == 'kingstonboulderingcooperative@gmail.com';
    }

    function memberDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function memberDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSupervisorOrAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (memberDocExists() && (
          memberDoc().data.get('isAdmin', false) == true ||
          memberDoc().data.get('isSupervisor', false) == true
        ))
      );
    }

    // Fields that only admins/supervisors may change on a boulder document.
    // Regular members can update any other field (grade votes, quality votes,
    // badge votes, updatedAt, etc.) without restriction.
    function touchesBoulderAdminFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'name', 'setter', 'setterEmail', 'seasonId',
        'locations', 'photo', 'removed', 'internalId', 'local', 'area',
        'permissions', 'createdAt'
      ]);
    }

    // Fields that only admins/supervisors may change on a member document.
    // A member updating their own profile cannot escalate privileges.
    function touchesMemberPrivilegedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isAdmin', 'isSupervisor', 'membershipAccessPass', 'membershipConfirmed',
        'membershipStart', 'membershipExpiry', 'punchPassRemaining',
        'pendingMembership', 'pendingPunches', 'amendedBy'
      ]);
    }

    // First Google sign-in for someone an admin pre-registered.
    //
    // services/profiles.ts findOrLinkProfile() copies their existing profile
    // to the real Firebase uid. That copy carries whatever isAdmin/isSupervisor
    // the admin already granted, which the self-create branch below rejects —
    // and isSupervisorOrAdmin() can't authorise it either, because it reads
    // users/{auth.uid}, the very document being created. Without this branch a
    // pre-registered supervisor is denied, findOrLinkProfile throws, and
    // OnboardingGate sends them to /setup as if they were a new member.
    //
    // The flags are re-checked against the profile named by linkedFrom, which
    // must already exist and carry this user's email, so this can only carry
    // privileges across — never mint them. An attacker can't point linkedFrom
    // at an admin's profile: the emails wouldn't match.
    function linkSource() {
      return get(/databases/$(database)/documents/users/$(request.resource.data.linkedFrom));
    }

    function linksOwnExistingProfile(uid) {
      return isAuthenticated() &&
        request.auth.uid == uid &&
        request.auth.token.get('email', '') != '' &&
        request.resource.data.get('linkedFrom', '') != '' &&
        request.resource.data.linkedFrom != uid &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.linkedFrom)) &&
        linkSource().data.get('email', '').lower() == request.auth.token.email.lower() &&
        request.resource.data.get('isAdmin', false) == linkSource().data.get('isAdmin', false) &&
        request.resource.data.get('isSupervisor', false) == linkSource().data.get('isSupervisor', false);
    }

    // A member may update their own access/purchase state as long as they
    // don't touch role fields and don't confirm their own purchase.
    //
    // membershipAccessPass is theirs to set — recording that they bought an
    // annual pass is the whole point of the purchase flow. What they may not do
    // is mark it confirmed, which is what used to be expressed as "cannot set
    // membershipStatus to 'active'". Splitting the pass from the confirmation
    // made that distinction sayable rather than encoded in one enum.
    function canSelfUpdateAccess(uid) {
      return isAuthenticated() &&
        request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isSupervisor', 'amendedBy']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['membershipConfirmed']) ||
          request.resource.data.membershipConfirmed == false);
    }

    // ── users/{uid} ───────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isAuthenticated();
      // Supervisors/admins can create any profile; authenticated users can self-register
      // as long as they don't grant themselves admin or supervisor privileges.
      allow create: if isSupervisorOrAdmin() ||
                       (isAuthenticated() &&
                        request.auth.uid == uid &&
                        request.resource.data.get('isAdmin', false) == false &&
                        request.resource.data.get('isSupervisor', false) == false) ||
                       linksOwnExistingProfile(uid);
      allow delete: if isSupervisorOrAdmin();
      allow update: if isSupervisorOrAdmin() ||
                       (isAuthenticated() &&
                        request.auth.uid == uid &&
                        !touchesMemberPrivilegedFields()) ||
                       // Members may purchase/use access for themselves (pending admin confirmation).
                       // They can write access fields but cannot set membershipConfirmed to true
                       // and cannot touch role fields.
                       canSelfUpdateAccess(uid) ||
                       // Auto-expire: members can clear their own lapsed pass — they
                       // cannot give themselves one. 'none' is the only destination.
                       (isAuthenticated() &&
                        request.auth.uid == uid &&
                        resource.data.membershipAccessPass != 'none' &&
                        request.resource.data.membershipAccessPass == 'none' &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['membershipAccessPass', 'lastUpdatedBy', 'lastUpdatedAt']));
    }

    // ── logs/{id} ─────────────────────────────────────────────────────────────
    // All members read the sign-in book; purchase entries are filtered client-side.
    match /logs/{logId} {
      allow read:           if isAuthenticated();
      allow create:         if isAuthenticated();
      allow update, delete: if isSupervisorOrAdmin();
    }

    // ── boulderSeasons/{id} ───────────────────────────────────────────────────
    match /boulderSeasons/{seasonId} {
      allow read:  if isAuthenticated();
      allow write: if isSupervisorOrAdmin();
    }

    // ── boulders/{id} ────────────────────────────────────────────────────────
    // Members can vote (grade, quality, badges); only admins/supervisors can
    // create, delete, or change structural fields.
    match /boulders/{boulderId} {
      allow read:           if isAuthenticated();
      allow create, delete: if isSupervisorOrAdmin();
      allow update:         if isSupervisorOrAdmin() ||
                               (isAuthenticated() && !touchesBoulderAdminFields());

      match /comments/{commentId} {
        allow read:           if isAuthenticated();
        allow create:         if isAuthenticated();
        allow update, delete: if isAuthenticated() &&
                                 (resource.data.uid == request.auth.uid ||
                                  isSupervisorOrAdmin());
      }
    }

    // ── climbLogs/{id} ───────────────────────────────────────────────────────
    // KBC logs (locationId == 'kbc') are readable by all members — used for
    // community stats on boulder cards. Logs at other locations are private.
    match /climbLogs/{logId} {
      allow read:           if isAuthenticated() && (
                               resource.data.uid == request.auth.uid ||
                               resource.data.locationId == 'kbc'
                            );
      allow create:         if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── climbLocations/{id} ──────────────────────────────────────────────────
    match /climbLocations/{locId} {
      allow read:           if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create:         if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── personalProblems/{id} ────────────────────────────────────────────────
    match /personalProblems/{problemId} {
      allow read:           if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create:         if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── gymStatus/{doc} ──────────────────────────────────────────────────────
    match /gymStatus/{doc} {
      allow read:  if isAuthenticated();
      allow write: if isSupervisorOrAdmin();
    }

    // ── boulderConfig/{doc} ──────────────────────────────────────────────────
    // Stores shared config (tape color pool). Read by all members; write by admins/supervisors.
    match /boulderConfig/{doc} {
      allow read:  if isAuthenticated();
      allow write: if isSupervisorOrAdmin();
    }

    // ── userBoulderData/{uid} ────────────────────────────────────────────────
    // Per-user data for KBC boulders (e.g. projectIds). Fully private to the owner.
    match /userBoulderData/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }
  }
}
