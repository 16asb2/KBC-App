{
  "expo": {
    "name": "KBC App",
    "slug": "kbc",
    "version": "0.2.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kbc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kbc.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "KBC needs access to your photo library to add photos to boulder problems."
      }
    },
    "android": {
      "package": "com.kbc.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "googleServicesFile": "./google-services.json",
          "iosUrlScheme": "com.googleusercontent.apps.451887190936-1lk1q56has03h02fgjm9lliso5384blc"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "695c47fa-5eb2-4e32-a1c8-e789ddd3defc"
      }
    },
    "owner": "kbc-climb"
  }
}
