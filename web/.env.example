# Firebase web config — public by design (safe to expose in the browser bundle).
# No admin credentials, OAuth client secrets, or refresh tokens belong in this file, ever.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App config — public by design (an email address, not a secret).
# The super-admin account is irrevocable and cannot be modified in-app;
# see src/domain/roles.ts.
VITE_SUPER_ADMIN_EMAIL=

# Calendar — the calendar ID is a public identifier (the KBC calendar is
# shared read-only), and the Cloud Functions base URL is just a hostname.
# Neither is a secret; see src/services/calendar.ts for how reads are
# mediated through functions/getAdminCalendarToken.
VITE_GOOGLE_CALENDAR_ID=
VITE_CLOUD_FUNCTIONS_BASE_URL=
