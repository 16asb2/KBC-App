# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — contains secrets, never commit
.env
.env.local
.env*.local

# Firebase config — contains API key; file stays local, not in repo
google-services.json
GoogleService-Info.plist

# Firebase service account credentials — secrets stored in EAS, never commit locally
*service-account*.json

# internal docs
PRODUCTION.md

# Claude Code local data
.claude/

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
